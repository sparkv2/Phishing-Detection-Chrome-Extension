[Unit]
Description=Rebuild the Tripwire threat list from the public feeds
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tripwire
Group=tripwire
ExecStart=/usr/bin/node /opt/tripwire/tools/build-threat-intel.mjs --out /var/lib/tripwire/intel
Environment=NODE_NO_WARNINGS=1
StateDirectory=tripwire
TimeoutStartSec=15min

# Needs outbound HTTPS to download feeds; nothing else.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ReadWritePaths=/var/lib/tripwire
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0027
MemoryMax=600M
